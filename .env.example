# Salin file ini menjadi .env (file .env tidak ikut ke GitHub) lalu isi dengan nilai dari proyek Supabase Anda:
# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Pakai "anon public" key (aman ada di frontend karena data dilindungi Row Level Security).
# JANGAN pernah memakai service_role key di sini.
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
